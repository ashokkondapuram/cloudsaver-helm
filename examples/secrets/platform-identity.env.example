# identity_app is an unprivileged role, separate from identity_owner.
database-url=postgresql://identity_app:REPLACE@platform-db.example.com:5432/identity?sslmode=verify-full
redis-url=rediss://:REPLACE@platform-redis.example.com:6380/0
# Use a securely generated hex value of at least 32 bytes. Preserve it across upgrades.
key-pepper=REPLACE_WITH_KEY_PEPPER
# SHA256 hex digests of all five caller tokens above plus the portal caller token.
caller-digests={"gateway":"REPLACE","tenant":"REPLACE","scanner":"REPLACE","analytics":"REPLACE","notification":"REPLACE","portal":"REPLACE"}
