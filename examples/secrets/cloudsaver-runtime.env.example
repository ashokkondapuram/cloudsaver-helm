# Copy to config/cloudsaver-runtime.env; replace every placeholder. Never commit the copy.
database-url=postgresql://cloudsaver_app:REPLACE@cloud-db.example.com:5432/cloudsaver?sslmode=verify-full
redis-gateway-url=rediss://:REPLACE@cloud-redis.example.com:6380/0
redis-worker-url=rediss://:REPLACE@cloud-redis.example.com:6380/1
gateway-token=REPLACE_WITH_GATEWAY_CALLER_TOKEN
tenant-token=REPLACE_WITH_TENANT_CALLER_TOKEN
scanner-token=REPLACE_WITH_SCANNER_CALLER_TOKEN
analytics-token=REPLACE_WITH_ANALYTICS_CALLER_TOKEN
notification-token=REPLACE_WITH_NOTIFICATION_CALLER_TOKEN
